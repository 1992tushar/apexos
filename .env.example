# Copy to apps/api/.env and apps/web/.env.local as needed.

# --- Backend (apps/api/.env) ---
APP_ENV=dev
DATABASE_URL=postgresql+psycopg://apex:apex@localhost:5432/apexos
CORS_ORIGINS=http://localhost:3000
# Dev auth: acts as this seeded user when no Clerk session is present.
DEV_ACTOR_EMAIL=founder@apexsupply.example

# --- Frontend (apps/web/.env.local) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
